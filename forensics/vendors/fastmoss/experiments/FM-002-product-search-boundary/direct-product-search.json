{
  "browser": {
    "mode": "launch",
    "executable_path": "/run/current-system/sw/bin/chromium",
    "headless": false
  },
  "start_url": { "url": "https://www.fastmoss.com/pt/e-commerce/search" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 10000 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "url"],
    "events": ["network", "console", "page-errors"],
    "network": {
      "response_body": true
    }
  }
}
